diff --git a/src/ggml-vulkan/vulkan-shaders/topk_mask.comp b/src/ggml-vulkan/vulkan-shaders/topk_mask.comp
new file mode 100644
index 00000000..c0f08408
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/topk_mask.comp
@@ -0,0 +1,73 @@
+#version 450
+
+#include "types.glsl"
+
+// topk_mask: keep the k largest elements of every row, set all others to -inf.
+// Same shape as the input; f32 only. One workgroup per row (dispatch y = nrows);
+// a single thread serially builds the top-k list in shared memory and the whole
+// workgroup applies the x >= c mask in one pass. No size-keyed pipeline table: k
+// is runtime push data, so one pipeline covers every supported size (the existing
+// topk_nary_search kernel cannot express a threshold-only output for ne[0] > 2^10).
+layout(local_size_x = 256) in;
+
+layout (binding = 0) readonly buffer A {float data_a[];};
+layout (binding = 1) writeonly buffer D {float data_d[];};
+
+layout (push_constant) uniform parameter {
+    uint ncols;
+    uint k;
+    uint nrows;
+} p;
+
+// the shim prelude exposes no INFINITY constant: a large negative literal is the
+// "masked" value. It must be <= every real logit (so the identity branch k >=
+// ncols keeps every element) and must stay far below any real value after
+// mul(inv_t) + gumbel noise so masked lanes never win the in-graph argmax
+const float NEG_INF = -1e38f;
+
+// k is runtime-checked in the support fn to be in [1, 63]; k == ncols is an
+// identity handled without touching the list (c = NEG_INF keeps every element)
+const uint KMAX = 64;
+shared float sh_list[KMAX];
+shared float sh_c;
+
+// top-k list: pre-filled with NEG_INF so every element takes the same replace
+// path (the fillers sort to the bottom and drop out as real values arrive).
+// The shift stays within [0, k-1], so no write ever leaves the list even at
+// k = KMAX - 1
+void list_replace(float v) {
+    for (uint i = 0; i < p.k; ++i) {
+        if (v > sh_list[i]) {
+            for (uint j = p.k - 1; j > i; --j) {
+                sh_list[j] = sh_list[j - 1];
+            }
+            sh_list[i] = v;
+            return;
+        }
+    }
+}
+
+void main() {
+    const uint row = gl_WorkGroupID.y;
+    const uint row_offset = row * p.ncols;
+
+    if (gl_LocalInvocationID.x == 0) {
+        if (p.k >= p.ncols) {
+            // k covers the whole row: identity
+            sh_c = NEG_INF;
+        } else {
+            for (uint i = 0; i < p.k; ++i) sh_list[i] = NEG_INF;
+            for (uint j = 0; j < p.ncols; ++j) {
+                list_replace(data_a[row_offset + j]);
+            }
+            sh_c = sh_list[p.k - 1]; // k-th largest
+        }
+    }
+    barrier();
+
+    const float c = sh_c;
+    for (uint i = gl_LocalInvocationID.x; i < p.ncols; i += 256) {
+        const float v = data_a[row_offset + i];
+        data_d[row_offset + i] = (v >= c) ? v : NEG_INF;
+    }
+}
