+// ggml_compute_forward_topk_mask
+
+static void ggml_compute_forward_topk_mask_f32(
+    const ggml_compute_params * params,
+    ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+
+    GGML_TENSOR_UNARY_OP_LOCALS
+
+    GGML_ASSERT(nb0 == sizeof(float));
+    GGML_ASSERT(nb00 == sizeof(float));
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const int64_t nr = ggml_nrows(src0);
+
+    const uint32_t k = dst->op_params[0]; // 0 when unset (k == 0: mask out everything)
+
+    std::vector<float> row;
+    row.reserve(ne00);
+
+    for (int64_t i = ith; i < nr; i += nth) {
+        const float * src_data = (float *)((char *) src0->data + i*nb01);
+        float * dst_data = (float *)((char *) dst->data + i*nb1);
+
+        if (k >= (uint32_t) ne00) {
+            // k covers the whole row: identity
+            std::copy(src_data, src_data + ne00, dst_data);
+            continue;
+        }
+        if (k == 0) {
+            std::fill(dst_data, dst_data + ne00, -std::numeric_limits<float>::infinity());
+            continue;
+        }
+
+        // c = k-th largest value of the row; an element survives iff x >= c, so
+        // exact-f32 ties at the k boundary are kept (the mask can then cover more
+        // than k elements)
+        row.assign(src_data, src_data + ne00);
+        std::nth_element(row.begin(), row.begin() + k - 1, row.end(), std::greater<float>());
+        const float c = row[k - 1];
+
+        for (int64_t j = 0; j < ne00; j++) {
+            dst_data[j] = (src_data[j] >= c) ? src_data[j] : -std::numeric_limits<float>::infinity();
+        }
+    }
+}
+
+void ggml_compute_forward_topk_mask(
+    const ggml_compute_params * params,
+    ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+
+    switch (src0->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_topk_mask_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
