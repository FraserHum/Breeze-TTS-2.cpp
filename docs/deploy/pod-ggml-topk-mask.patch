+// ggml_topk_mask
+
+struct ggml_tensor * ggml_topk_mask(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        int                   k) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32);
+    GGML_ASSERT(k >= 0);
+
+    // same shape and type as the input: k cannot live in the shape (the output is
+    // not smaller), so it rides in op_params
+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, a->type, a->ne[0], a->ne[1], a->ne[2], a->ne[3]);
+
+    result->op     = GGML_OP_TOPK_MASK;
+    result->src[0] = a;
+
+    result->op_params[0] = (uint32_t) k;
+
+    return result;
+}
