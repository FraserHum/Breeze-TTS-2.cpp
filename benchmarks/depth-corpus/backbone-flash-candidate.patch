+}
+
+struct DiffStats {
+    bool finite = true;
+    double max_abs = 0.0;
+    double relative_l2 = 0.0;
+};
+
+static DiffStats diff_stats(const std::vector<float> & reference, const std::vector<float> & candidate) {
+    DiffStats stats;
+    if (reference.size() != candidate.size()) {
+        stats.finite = false;
+        return stats;
+    }
+    double reference_l2 = 0.0;
+    double delta_l2 = 0.0;
+    for (size_t i = 0; i < reference.size(); ++i) {
+        if (!std::isfinite(reference[i]) || !std::isfinite(candidate[i])) stats.finite = false;
+        const double delta = static_cast<double>(candidate[i]) - reference[i];
+        stats.max_abs = std::max(stats.max_abs, std::abs(delta));
+        reference_l2 += static_cast<double>(reference[i]) * reference[i];
+        delta_l2 += delta * delta;
+    }
+    stats.relative_l2 = std::sqrt(delta_l2) / std::max(std::sqrt(reference_l2), 1.0e-12);
+    return stats;
+}
+
+static bool set_flash_attention(bool enabled) {
+    return setenv("BREEZE_BB_FLASH_ATTN", enabled ? "1" : "0", 1) == 0;
