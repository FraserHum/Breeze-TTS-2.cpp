        "transcription": [
          {
            "timestamps": {
              "from": "00:00:00,000",
              "to": "00:00:04,400"
            },
            "offsets": {
              "from": 0,
              "to": 4400
            },
            "text": "傍晚山上的七巷站为社区开放一间小型修剪教室"
          },
          {
            "timestamps": {
              "from": "00:00:05,000",
              "to": "00:00:09,000"
            },
            "offsets": {
              "from": 5000,
              "to": 9000
            },
            "text": "志工把黄铜仪器从储藏室搬到工作桌"
          },
          {
            "timestamps": {
              "from": "00:00:09,200",
              "to": "00:00:11,600"
            },
            "offsets": {
              "from": 9200,
              "to": 11600
            },
            "text": "柔和的灯光照亮每张标签"
          },
          {
            "timestamps": {
              "from": "00:00:11,600",
              "to": "00:00:13,200"
            },
            "offsets": {
              "from": 11600,
              "to": 13200
            },
            "text": "七巷员检查气压计"
          },
          {
            "timestamps": {
              "from": "00:00:13,600",
              "to": "00:00:17,700"
            },
            "offsets": {
              "from": 13600,
              "to": 17700
            },
            "text": "两名学徒清理从海岸带回的风向标上的岩痕"
          },
          {
            "timestamps": {
              "from": "00:00:18,000",
              "to": "00:00:20,700"
            },
            "offsets": {
              "from": 18000,
              "to": 20700
            },
            "text": "楼梯旁 挡印员摊开新图"
          },
          {
            "timestamps": {
              "from": "00:00:20,800",
              "to": "00:00:23,100"
            },
            "offsets": {
              "from": 20800,
              "to": 23100
            },
            "text": "把每个日期抄进新的登记簿"
          },
          {
            "timestamps": {
              "from": "00:00:23,400",
              "to": "00:00:27,000"
            },
            "offsets": {
              "from": 23400,
              "to": 27000
            },
            "text": "管理员两好裂开的窗框换上三枚螺丝"
          },
          {
            "timestamps": {
              "from": "00:00:27,200",
              "to": "00:00:30,500"
            },
            "offsets": {
              "from": 27200,
              "to": 30500
            },
            "text": "并在木条上留下明天木匠要处理的位置"
          },
          {
            "timestamps": {
              "from": "00:00:30,800",
              "to": "00:00:33,600"
            },
            "offsets": {
              "from": 30800,
              "to": 33600
            },
            "text": "休息时来访者谈起冬夜的天空"
          },
          {
            "timestamps": {
              "from": "00:00:33,800",
              "to": "00:00:34,800"
            },
            "offsets": {
              "from": 33800,
              "to": 34800
            },
            "text": "渡船的旅程"
          },
          {
            "timestamps": {
              "from": "00:00:35,000",
              "to": "00:00:37,400"
            },
            "offsets": {
              "from": 35000,
              "to": 37400
            },
            "text": "以及第一次看见土星的情景"
          },
          {
            "timestamps": {
              "from": "00:00:37,600",
              "to": "00:00:38,700"
            },
            "offsets": {
              "from": 37600,
              "to": 38700
            },
            "text": "课程结束前"
          },
          {
            "timestamps": {
              "from": "00:00:38,900",
              "to": "00:00:41,500"
            },
            "offsets": {
              "from": 38900,
              "to": 41500
            },
            "text": "宜安替备用镜片整理一个架子"
          },
          {
            "timestamps": {
              "from": "00:00:41,700",
              "to": "00:00:44,800"
            },
            "offsets": {
              "from": 41700,
              "to": 44800
            },
            "text": "又在紧急无线店旁写下清楚的提醒"
          },
          {
            "timestamps": {
              "from": "00:00:45,000",
              "to": "00:00:46,800"
            },
            "offsets": {
              "from": 45000,
              "to": 46800
            },
            "text": "大家约定日出后再见"
          },
          {
            "timestamps": {
              "from": "00:00:47,200",
              "to": "00:00:48,400"
            },
            "offsets": {
              "from": 47200,
              "to": 48400
            },
            "text": "逐一测试仪器"
          },
          {
            "timestamps": {
              "from": "00:00:48,700",
              "to": "00:00:51,000"
            },
            "offsets": {
              "from": 48700,
              "to": 51000
            },
            "text": "把修好的新图送回当宴库"
          },
          {
            "timestamps": {
              "from": "00:00:51,000",
              "to": "00:00:52,100"
            },
            "offsets": {
              "from": 51000,
              "to": 52100
            },
            "text": "细心的合作"
          },
          {
            "timestamps": {
              "from": "00:00:52,300",
              "to": "00:00:53,600"
            },
            "offsets": {
              "from": 52300,
              "to": 53600
            },
            "text": "让这座老七巷站"
          },
          {
            "timestamps": {
              "from": "00:00:53,800",
              "to": "00:00:56,200"
            },
            "offsets": {
              "from": 53800,
              "to": 56200
            },
            "text": "准备好迎接下一季的观测工作"
          },
          {
            "timestamps": {
              "from": "00:00:56,700",
              "to": "00:00:59,000"
            },
            "offsets": {
              "from": 56700,
              "to": 59000
            },
            "text": "他还把每项工具的归还时间"
          },
          {
            "timestamps": {
              "from": "00:00:59,200",
              "to": "00:01:00,300"
            },
            "offsets": {
              "from": 59200,
              "to": 60300
            },
            "text": "写在黑板上"
          },
          {
            "timestamps": {
              "from": "00:01:00,500",
              "to": "00:01:02,900"
            },
            "offsets": {
              "from": 60500,
              "to": 62900
            },
            "text": "提醒所有人保持走道畅通"
          }
        ]
      }
